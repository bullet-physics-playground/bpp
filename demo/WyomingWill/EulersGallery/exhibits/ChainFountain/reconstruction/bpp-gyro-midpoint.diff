 #include <BulletSoftBody/btSoftBodyRigidBodyCollisionConfiguration.h>
 #include <BulletSoftBody/btSoftRigidDynamicsWorld.h>
 
+// A rigid body's gyroscopic term, solved together with its contacts and
+// joints, for bodies a script marks with BPP_GYRO_MIDPOINT in their flags
+// (body:setFlags(1024); Bullet's own gyroscopic flags off). Before every
+// step: the body's spin takes the linearly implicit midpoint step of
+// Euler's equations, (I + dt/2 Jg) dw = -dt w x I w with Jg = d(w x I w)/dw,
+// and for this step the body answers impulses through (I + dt/2 Jg)^-1
+// instead of I^-1, so the solver sees the gyroscopic coupling implicitly.
+// Bullet puts I^-1 back when it moves the body at the end of the step.
+// (Bullet's own term, applied outside the solve and by backward Euler,
+// takes energy out of a free tumbling body, and for small bodies in
+// kg and cm, whose determinant is under FLT_EPSILON, is not applied at all.)
+namespace {
+const int BPP_GYRO_MIDPOINT = 1 << 10;
+void bppGyroPreTick(btDynamicsWorld *world, btScalar dt) {
+  btCollisionObjectArray &objs = world->getCollisionObjectArray();
+  for (int i = 0; i < objs.size(); i++) {
+    btRigidBody *b = btRigidBody::upcast(objs[i]);
+    if (b == nullptr || b->getInvMass() == 0 || !(b->getFlags() & BPP_GYRO_MIDPOINT) ||
+        !b->isActive() || b->isStaticOrKinematicObject())
+      continue;
+    const btMatrix3x3 &R = b->getWorldTransform().getBasis();
+    btMatrix3x3 I = R.scaled(b->getLocalInertia()) * R.transpose();
+    btVector3 w = b->getAngularVelocity();
+    btVector3 Iw = I * w;
+    btMatrix3x3 Sw, SIw;
+    w.getSkewSymmetricMatrix(&Sw[0], &Sw[1], &Sw[2]);
+    Iw.getSkewSymmetricMatrix(&SIw[0], &SIw[1], &SIw[2]);
+    btMatrix3x3 A = I + (Sw * I - SIw) * (btScalar(0.5) * dt);
+    btMatrix3x3 Ainv = A.inverse();
+    b->setAngularVelocity(w + Ainv * (w.cross(Iw) * -dt));
+    // (the body itself is not const: Bullet only hands out a const reference)
+    const_cast<btMatrix3x3 &>(b->getInvInertiaTensorWorld()) = Ainv;
+  }
+}
+} // namespace
+
