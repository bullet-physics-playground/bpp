diff --git a/windows/povconfig/syspovconfig_mingw32.h b/windows/povconfig/syspovconfig_mingw32.h
new file mode 100644
index 0000000..dd1d586
--- /dev/null
+++ b/windows/povconfig/syspovconfig_mingw32.h
@@ -0,0 +1,75 @@
+//******************************************************************************
+///
+/// @file windows/povconfig/syspovconfig_mingw32.h
+///
+/// MinGW-w64 (GCC) compiler-specific POV-Ray compile-time configuration.
+///
+/// This header configures aspects of POV-Ray for compiling in an MSYS2
+/// MinGW-w64 build environment. It is the GCC counterpart of
+/// syspovconfig_msvc.h; it is pulled in by windows/povconfig/syspovconfig.h
+/// when __MINGW32__ is defined.
+///
+/// Intentionally left close to the MSVC header, but:
+///  * no <intrin.h> / _ReturnAddress() / #pragma warning (GCC has none of
+///    those, and syspovconfig.h already defines ReturnAddress() as NULL);
+///  * no __int64/__forceinline/__intN MSVC types -- mapped to the GCC
+///    equivalents;
+///  * TRY_OPTIMIZED_NOISE* and POV_CPUINFO* deliberately NOT defined: they
+///    require POV-Ray's platform/x86/ sources (cpuid.cpp plus the hand-tuned
+///    AVX/AVX2/FMA noise), none of which povray-mingw/povvfe.pro compiles,
+///    and MachineAssembler-free portable noise in
+///    source/core/material/portablenoise.cpp is used instead.
+///
+//******************************************************************************
+
+#ifndef POVRAY_WINDOWS_SYSPOVCONFIG_MINGW32_H
+#define POVRAY_WINDOWS_SYSPOVCONFIG_MINGW32_H
+
+// Integer type names (<cstdint> also makes configbase.h's default
+// POV_OFF_T = std::int_least64_t resolve).
+#include <cstdint>
+
+// GCC version (compiled as C++11, see povray-mingw/povvfe.pro).
+#define POV_CPP11_SUPPORTED               1
+#define POV_COMPILER_VER                  "gcc"
+#define METADATA_COMPILER_STRING          "gcc " __VERSION__
+
+#ifdef _WIN64
+  #define METADATA_PLATFORM_STRING        "x86_64-pc-win"
+#elif defined(__i386__)
+  #define METADATA_PLATFORM_STRING        "i686-pc-win"
+#else
+  #error "Please update syspovconfig_mingw32.h to include this Windows architecture"
+#endif
+
+// Integral type widths. These MUST be single-word typedef names (as in
+// unix/povconfig/syspovconfig.h) rather than multi-word spellings such as
+// MSVC's "unsigned __int16": POV code uses them in functional-cast syntax,
+// e.g. POV_UINT16(x) in source/parser/parser.cpp, which only accepts a
+// simple-type-specifier.
+#define POV_INT8                          int8_t
+#define POV_UINT8                         uint8_t
+#define POV_INT16                         int16_t
+#define POV_UINT16                        uint16_t
+#define POV_INT32                         int32_t
+#define POV_UINT32                        uint32_t
+#define POV_INT64                         int64_t
+#define POV_UINT64                        uint64_t
+
+// Windows is LLP64: long is 32 bits, so a 64-bit POV_LONG needs long long.
+#define POV_LONG                          signed long long
+#define POV_ULONG                         unsigned long long
+#define FORCEINLINE                       inline __attribute__((always_inline))
+
+// No AVX/FMA noise and no CPUID-driven dispatch (see file header): those need
+// platform/x86 sources this build does not compile.
+#undef TRY_OPTIMIZED_NOISE
+#undef TRY_OPTIMIZED_NOISE_AVX
+#undef TRY_OPTIMIZED_NOISE_AVX_PORTABLE
+#undef TRY_OPTIMIZED_NOISE_AVXFMA4
+#undef TRY_OPTIMIZED_NOISE_AVX2FMA3
+#undef POV_CPUINFO
+#undef POV_CPUINFO_DETAILS
+#undef POV_CPUINFO_H
+
+#endif // POVRAY_WINDOWS_SYSPOVCONFIG_MINGW32_H

