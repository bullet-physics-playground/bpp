#!/usr/bin/make -f

# Uncomment this to turn on verbose mode.
export DH_VERBOSE=1

CXXFLAGS = -Wall -g

ifneq (,$(findstring noopt,$(DEB_BUILD_OPTIONS)))
	CXXFLAGS += -O0
else
	CXXFLAGS += -O2
endif
ifeq (,$(findstring nostrip,$(DEB_BUILD_OPTIONS)))
        INSTALL_PROGRAM += -s
endif

# Qt 6 where the distribution has libQGLViewer for it (debian/control lists
# it first), else Qt 5, as older ones have only that (Ubuntu 24.04, Debian 12
# and 13): bpp builds with either. Qt 5's qmake by its path, as both may be
# installed and a plain qmake could be either.
ifeq ($(shell dpkg-query -W -f='$${Status}' libqglviewer-dev-qt6 2>/dev/null),install ok installed)
QMAKE = qmake6
QT_SVG = libqt6svg6
else
QMAKE = /usr/lib/qt5/bin/qmake
QT_SVG = libqt5svg5
endif

QMAKE_AFTER = -after \
	      'QMAKE_CXXFLAGS_RELEASE = $(CXXFLAGS)' \
	      'QMAKE_POST_LINK ~= s/strip/:'

build: build-stamp
build-stamp: $(QUILT_STAMPFN)
	dh_testdir

	if [ -d ../povray ]; then cd povray-linux && $(QMAKE) povvfe.pro && $(MAKE); cd -; fi
	$(QMAKE) "USE_VFE=1" $(QMAKE_AFTER) bpp.pro && $(MAKE)

	touch $@

clean:
	dh_testdir
	dh_testroot
	rm -f build-stamp
	rm -f release/bpp debug/bpp
	[ ! -f Makefile ] || $(MAKE) clean
	dh_clean

install: build
	dh_testdir
	dh_testroot
	dh_prep
	dh_installdirs

	$(MAKE) INSTALL_ROOT=$(CURDIR)/debian/bpp install
	install -d -v -m 0755 $(CURDIR)/debian/bpp/usr/share/applications
	chmod 664 $(CURDIR)/debian/bpp/usr/share/applications/bpp.desktop

	install -d -v -m 0755 $(CURDIR)/debian/bpp/usr/share/icons/hicolor/scalable/apps
	chmod 664 $(CURDIR)/debian/bpp/usr/share/icons/hicolor/scalable/apps/bpp.svg

	install -d -v -m 0755 $(CURDIR)/debian/bpp/usr/bin
	install -m 755 -p release/bpp $(CURDIR)/debian/bpp/usr/bin/bpp
	
	install -d -v -m 0755 $(CURDIR)/debian/bpp/usr/share/bpp
	cp -rpv demo $(CURDIR)/debian/bpp/usr/share/bpp/demo
	cp -rpv includes $(CURDIR)/debian/bpp/usr/share/bpp/includes

# Build architecture-independent files here.
binary-indep: build install
	dh_testdir
	dh_testroot
#	dh_installchangelogs ChangeLog
	dh_installdocs -i
	dh_install -i
	dh_installman -i
	dh_compress -i --exclude=.cpp --exclude=.pri
	dh_fixperms
	dh_installdeb
	dh_gencontrol
	dh_md5sums
	dh_builddeb

# Build architecture-dependent files here.
binary-arch: build install
	dh_testdir
	dh_testroot
#	dh_installchangelogs ChangeLog
	dh_installdocs -s README.md
	dh_install -s --sourcedir=$(CURDIR)/debian/tmp
	dh_installman bpp.1
	dh_installmime
	dh_installmenu
	dh_link
	dh_strip
	dh_compress -s
	dh_fixperms
	dh_makeshlibs
	dh_installdeb
	dh_shlibdeps
	dh_gencontrol -- -Vbpp:QtSvg=$(QT_SVG)
	dh_md5sums
	dh_builddeb

binary: binary-indep binary-arch
.PHONY: build clean binary-indep binary-arch binary install configure
